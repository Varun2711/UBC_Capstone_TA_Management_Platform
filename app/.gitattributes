# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly enforce LF for scripts
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Treat shell scripts as text for diff/merge
*.sh diff=sh

# Prevent git from normalizing images or binaries
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
